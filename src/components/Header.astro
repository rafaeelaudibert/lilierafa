---
import { Image } from "astro:assets"
import { WEDDING_CONFIG, type Locale } from "../constants/wedding"
import { getLocale } from "astro-i18n-aut"
import monograma from "../assets/monograma.png"

const locale = getLocale(Astro.url) as Locale
const config = WEDDING_CONFIG[locale]
---

<header class="w-full fixed top-0 left-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-4">
    <div class="grid grid-cols-3 items-center">
      <div></div>
      <div class="flex justify-center">
        <a href={locale === "pt" ? "/" : `/${locale}/`} class="flex items-center">
          <Image
            src={monograma}
            alt={config.couple.them}
            class="h-8 w-auto filter brightness-0 invert"
            loading="eager"
          />
        </a>
      </div>
      <div class="flex justify-end">
        <a
          href={config.movieUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-full text-sm bg-white text-slate-600 hover:bg-gray-100 transition-colors duration-300"
        >
          {config.cta}
        </a>
      </div>
    </div>
  </div>
</header>
