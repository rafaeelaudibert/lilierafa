---
import { WEDDING_CONFIG, type Locale } from "../constants/wedding"
import { getLocale } from "astro-i18n-aut"

const locale = getLocale(Astro.url) as Locale
const config = WEDDING_CONFIG[locale]
---

<header
  id="header-nav"
  class="w-full fixed top-0 left-0 z-50 transition-all duration-600"
>
  <div class="max-w-6xl mx-auto px-4 py-4">
    <div class="flex flex-row justify-between sm:grid grid-cols-3 items-center">
      <div class="hidden sm:flex justify-start gap-4">
        {
          config.navigation.map((link) => (
            <a
              href={link.href}
              class="nav-link text-white transition-colors duration-600"
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="flex justify-center">
        <a
          id="header-logo"
          href="#hero-reference"
          class="font-semibold text-white sm:text-[var(--theme3)] transition-all sm:opacity-0 duration-600"
          >{config.couple.them}</a
        >
      </div>
      <div class="flex justify-end">
        <a
          href="#rsvp"
          id="header-button"
          class="px-4 py-2 rounded-full text-sm transition-all duration-600"
        >
          {config.cta}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const headerNav = document.getElementById("header-nav")!
  const headerLogo = document.getElementById("header-logo")!
  const navLinks = document.querySelectorAll(".nav-link")!
  const headerButton = document.getElementById("header-button")!

  function updateHeaderStyles() {
    const scrollY = window.scrollY
    const threshold = window.innerHeight - 100 // 100svh equivalent

    // Initial state
    if (scrollY < threshold) {
      headerNav.classList.remove("backdrop-blur")
      navLinks.forEach((link) => {
        link.classList.remove("text-[var(--theme3)]")
        link.classList.add("text-white")
      })
      headerLogo.classList.add("text-white", "sm:opacity-0")
      headerLogo.classList.remove("text-[var(--theme3)]", "sm:opacity-100")
      headerButton.classList.remove(
        "bg-[var(--theme1)]",
        "text-white",
        "hover:bg-[var(--theme2)]"
      )
      headerButton.classList.add(
        "bg-white",
        "text-slate-600",
        "hover:bg-gray-100"
      )
    } else {
      // Scrolled state
      headerNav.classList.add("backdrop-blur")
      navLinks.forEach((link) => {
        link.classList.remove("text-white")
        link.classList.add("text-[var(--theme3)]")
      })
      headerLogo.classList.remove("text-white", "sm:opacity-0")
      headerLogo.classList.add("text-[var(--theme3)]", "sm:opacity-100")
      headerButton.classList.remove(
        "bg-white",
        "text-slate-600",
        "hover:bg-gray-100"
      )
      headerButton.classList.add(
        "bg-[var(--theme1)]",
        "text-white",
        "hover:bg-[var(--theme2)]"
      )
    }
  }

  // Initial call
  updateHeaderStyles()

  // Listen for scroll events
  window.addEventListener("scroll", updateHeaderStyles)
</script>
